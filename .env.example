# Copie este arquivo para .env e preencha com os valores do Firebase Console
# (Configurações do projeto → Seus aplicativos → app Web → firebaseConfig).
# Depois de alterar o .env, reinicie com: npx expo start -c
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional — login com Google (Google Cloud Console → Credenciais → IDs do cliente OAuth).
# O botão "Entrar com Google" só aparece quando o ID da plataforma atual está preenchido.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
